{
  "id": "/?app=zhuguang",
  "name": "逐光运动教练服务平台",
  "short_name": "逐光",
  "description": "连接经过资料核验的退役运动员教练与学员家庭，提供透明、可预约、可持续的训练服务。",
  "lang": "zh-CN",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "orientation": "any",
  "background_color": "#ffffff",
  "theme_color": "#06130f",
  "categories": ["sports", "education", "business", "productivity"],
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "32x32",
      "type": "image/svg+xml"
    },
    {
      "src": "/app-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "/app-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/app-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "找教练",
      "short_name": "找教练",
      "description": "按项目、区域和训练目标比较北京教练。",
      "url": "/coaches",
      "icons": [{ "src": "/app-icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "我的预约",
      "short_name": "预约",
      "description": "进入学员预约与履约记录。",
      "url": "/student/bookings",
      "icons": [{ "src": "/app-icon-192.png", "sizes": "192x192" }]
    }
  ]
}
