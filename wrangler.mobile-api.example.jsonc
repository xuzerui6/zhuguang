{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zhuguang-mobile-api",
  "main": "worker/mobile-api.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zhuguang-mobile-api",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "zhuguang-coach-media"
    },
    {
      "binding": "RELEASES",
      "bucket_name": "zhuguang-mobile-releases"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "APP_ENV": "production",
    "CORS_ORIGINS": "https://zhuguang-coach-platform.xuzerui6.chatgpt.site",
    "MOBILE_API_ORIGIN": "https://zhuguang-mobile-api.example.workers.dev",
    "SMS_DAILY_BUDGET": "500"
  }
}
