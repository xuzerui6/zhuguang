{
  "name": "coach-match-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/run-vinext.mjs dev",
    "build": "node scripts/run-vinext.mjs build",
    "web:worker:prepare": "node scripts/prepare-web-worker-build.mjs",
    "web:worker:deploy": "npm run web:worker:prepare && wrangler deploy --config dist/server/wrangler.web.json",
    "start": "node scripts/run-vinext.mjs start",
    "preview": "node scripts/local-preview-server.mjs",
    "preview:background": "node scripts/start-preview-background.mjs",
    "test": "npm run test:unit && npm run build && node --test tests/rendered-html.test.mjs",
    "test:unit": "tsx --test tests/mobile-domain.test.ts tests/api-integration.test.ts tests/web-platform.test.ts tests/request-limits.test.ts tests/reaudit.test.ts tests/product-readiness.test.ts",
    "typecheck": "tsc --noEmit --noUnusedLocals --noUnusedParameters --incremental false",
    "lint": "eslint app tests scripts miniapp/src --ignore-pattern dist --ignore-pattern .next --ignore-pattern outputs",
    "lint:bounded": "node scripts/run-bounded.mjs 120000 node node_modules/eslint/bin/eslint.js app tests scripts --ignore-pattern dist --ignore-pattern .next --ignore-pattern outputs",
    "db:generate": "drizzle-kit generate",
    "native:check": "node scripts/check-native-readiness.mjs",
    "native:lint": "node scripts/native-lint.mjs",
    "native:toolchain": "node scripts/check-native-toolchain.mjs",
    "brand:icons": "node scripts/generate-brand-assets.mjs",
    "native:icons": "node scripts/sync-native-icons.mjs",
    "mobile:web:build": "vite build --config native/mobile/vite.config.ts",
    "mobile:sync": "npm run mobile:web:build && cap sync",
    "mobile:android:sync": "npm run mobile:web:build && cap sync android",
    "mobile:android:open": "cap open android",
    "mobile:android:build": "npm run mobile:android:apk",
    "mobile:android:apk": "npm run mobile:android:release",
    "mobile:android:release": "node scripts/build-android-apk.mjs",
    "mobile:ios:sync": "node scripts/sync-ios-project.mjs",
    "mobile:ios:open": "cap open ios",
    "mobile:ios:build": "npm run mobile:ios:sync && cap build ios",
    "desktop:prepare": "node scripts/prepare-desktop-app.mjs",
    "desktop:info": "tauri info",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "miniapp:dev": "npm --prefix miniapp run dev:weapp",
    "miniapp:build": "npm --prefix miniapp run build:weapp",
    "miniapp:typecheck": "npm --prefix miniapp run typecheck",
    "miniapp:check": "npm --prefix miniapp run check:readiness",
    "release:manifest": "node scripts/generate-release-manifest.mjs"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.4.2",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/network": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "drizzle-orm": "0.45.2",
    "jose": "^6.1.0",
    "lucide": "^1.28.0",
    "lucide-react": "^1.28.0",
    "morphicons": "^1.7.0",
    "motion": "^13.4.0",
    "next": "16.3.8",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tencentcloud-sdk-nodejs-sms": "^4.1.240"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "react-server-dom-webpack": "19.2.6",
    "sharp": "^0.35.3",
    "tailwindcss": "4.3.3",
    "tsx": "^4.22.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "postcss": "8.5.23",
    "nanoid": "3.3.18",
    "tencentcloud-sdk-nodejs-common": {
      "uuid": "11.1.1"
    }
  },
  "type": "module"
}
