{
  "name": "coach-match-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/run-vinext.mjs dev",
    "build": "node scripts/run-vinext.mjs build",
    "start": "node scripts/run-vinext.mjs start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint app tests scripts --ignore-pattern dist --ignore-pattern .next --ignore-pattern outputs",
    "db:generate": "drizzle-kit generate",
    "native:check": "node scripts/check-native-readiness.mjs",
    "native:toolchain": "node scripts/check-native-toolchain.mjs",
    "native:icons": "node scripts/sync-native-icons.mjs",
    "mobile:sync": "npm run build && cap sync",
    "mobile:android:sync": "npm run build && cap sync android",
    "mobile:android:open": "cap open android",
    "mobile:android:build": "npm run build && cap build android",
    "mobile:ios:sync": "npm run build && cap sync ios",
    "mobile:ios:open": "cap open ios",
    "mobile:ios:build": "npm run build && cap build ios",
    "desktop:prepare": "node scripts/prepare-desktop-app.mjs",
    "desktop:info": "tauri info",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build"
  },
  "dependencies": {
    "@capacitor/core": "^8.4.2",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
