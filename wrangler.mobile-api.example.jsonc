{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zhuguang-mobile-api",
  "main": "worker/mobile-api.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zhuguang-mobile-api",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "zhuguang-coach-media"
    },
    {
      "binding": "RELEASES",
      "bucket_name": "zhuguang-mobile-releases"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "APP_ENV": "production",
    "BEIJING_CATALOG_V2_ENABLED": "false",
    "CORS_ORIGINS": "https://beijingzhuguang.top,https://www.beijingzhuguang.top",
    "MOBILE_API_ORIGIN": "https://api.beijingzhuguang.top",
    "FULFILLMENT_V2_ENABLED": "false",
    "ONLINE_TRANSACTION_ENABLED": "false",
    "PAYMENT_PROVIDER": "none",
    "PRIMARY_OPERATOR_EMAIL": "REPLACE_WITH_PRIMARY_OPERATOR_EMAIL",
    "PUBLIC_TRUST_METRICS_ENABLED": "false",
    "SMS_DAILY_BUDGET": "500",
    "SUPPORT_EVIDENCE_ENABLED": "false"
  }
}
